<style>
  /* FONTES NINJA / ANIME */
  @import url('https://fonts.googleapis.com/css2?family=Kaushan+Script&family=Yusei+Magic&family=Marcellus&display=swap');

  /* ESTILOS GERAIS DA FICHA */
  .shinobi.sheet.actor {
    min-width: 950px;
    min-height: 750px;
  }
  
  .shinobi-wrapper {
    background: #e6dfcf;
    background-image: 
      radial-gradient(circle at 100% 50%, rgba(0,0,0,0.05) 0%, transparent 50%),
      radial-gradient(circle at 0% 0%, rgba(200, 180, 150, 0.4) 0%, transparent 40%);
    background-size: cover;
    background-position: center;
    background-blend-mode: multiply;
    padding: 20px;
    height: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    font-family: 'Marcellus', serif;
    color: #332b22;
  }

  .jp-text { font-family: 'Yusei Magic', sans-serif; }
  .title-font { font-family: 'Kaushan Script', cursive; }

  /* CABEÇALHO SUPERIOR (TÍTULO) */
  .top-title-area {
    display: flex;
    align-items: flex-end;
    margin-bottom: 10px;
  }
  .top-title-area .logo-placeholder {
    width: 60px; height: 60px;
    background: url('icons/svg/combat.svg') no-repeat center center;
    background-size: contain;
    opacity: 0.7;
    margin-right: 15px;
  }
  .top-title-area h1 {
    font-family: 'Kaushan Script', cursive;
    font-size: 42px;
    margin: 0; border: none;
    line-height: 1;
    color: #1a1510;
    text-shadow: 1px 1px 2px rgba(255,255,255,0.5);
  }
  .top-title-area .jp-sub {
    font-size: 16px;
    color: #665c4d;
    margin-left: 10px;
    letter-spacing: 2px;
  }

  /* ÁREA DE DADOS DO PERSONAGEM (CABEÇALHO) */
  .header-grid-area {
    display: flex;
    gap: 20px;
    margin-bottom: 15px;
  }
  .profile-section {
    position: relative;
    width: 160px; height: 160px;
    border: 3px solid #4a3e30;
    box-shadow: 3px 3px 8px rgba(0,0,0,0.3);
    background: #000;
  }
  .profile-section img {
    width: 100%; height: 100%; object-fit: cover; border: none;
  }
  .profile-section .vertical-tag {
    position: absolute;
    left: -25px; top: 10px;
    background: #e6dfcf;
    border: 1px solid #4a3e30;
    padding: 10px 5px;
    writing-mode: vertical-rl;
    text-orientation: upright;
    font-family: 'Yusei Magic', sans-serif;
    font-size: 20px;
    font-weight: bold;
    box-shadow: -2px 2px 5px rgba(0,0,0,0.2);
  }

  .dados-box {
    flex: 1;
    background: rgba(245, 240, 230, 0.6);
    border: 1px solid #a89f91;
    border-radius: 2px;
    padding: 10px 15px;
    position: relative;
    box-shadow: inset 0 0 10px rgba(0,0,0,0.05);
  }
  .dados-box::after {
    content: "🍥";
    position: absolute; right: 10px; top: 50%;
    transform: translateY(-50%);
    font-size: 120px; color: rgba(0,0,0,0.03);
    pointer-events: none;
  }

  .dados-box .dados-title {
    font-size: 12px; font-weight: bold; color: #5a4f40;
    border-bottom: 1px solid #a89f91; padding-bottom: 2px; margin-bottom: 8px;
    display: flex; justify-content: space-between;
  }
  
  .dados-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px 15px;
  }
  .dados-grid .campo { display: flex; flex-direction: column; }
  .dados-grid .campo.span-3 { grid-column: span 3; }
  .dados-grid label { font-size: 10px; color: #665c4d; font-weight: bold; letter-spacing: 0.5px; }
  .dados-grid input {
    background: transparent; border: none; border-bottom: 1px solid #b8b0a1;
    font-family: 'Marcellus', serif; font-size: 14px; color: #1a1510;
    padding: 2px 0; border-radius: 0;
  }
  .dados-grid input:focus { outline: none; border-bottom: 2px solid #5a4f40; }
  
  .nc-box {
    text-align: center;
  }
  .nc-box input {
    width: 60px; height: 40px; font-size: 24px; font-weight: bold;
    text-align: center; background: #dcd3c1; border: 1px solid #a89f91;
    border-radius: 5px; color: #4a3e30; margin-top: 5px;
  }

  /* MENU DE NAVEGAÇÃO */
  .sns-nav {
    display: flex; gap: 5px; margin-bottom: 15px;
    border-bottom: 2px solid #5a4f40; padding-bottom: 2px;
  }
  .sns-nav .item {
    background: rgba(230, 223, 207, 0.8);
    border: 1px solid #a89f91; border-bottom: none;
    border-radius: 5px 5px 0 0; padding: 6px 15px;
    font-weight: bold; font-size: 12px; color: #4a3e30;
    cursor: pointer; display: flex; align-items: center; gap: 5px;
    transition: 0.2s;
  }
  .sns-nav .item:hover { background: #f0eadd; }
  .sns-nav .item.active { background: #5a4f40; color: #fff; }
  .sns-nav .item .jp { font-family: 'Yusei Magic'; font-size: 16px; font-weight: normal; }

  /* CORPO PRINCIPAL E CAIXAS */
  .sheet-body { flex: 1; overflow-y: auto; overflow-x: hidden; padding-right: 5px; }
  .sns-box {
    background: rgba(245, 240, 230, 0.7);
    border: 1px solid #a89f91;
    border-radius: 3px; padding: 12px; margin-bottom: 12px;
    box-shadow: 1px 1px 4px rgba(0,0,0,0.1);
    position: relative; overflow: hidden;
  }
  .sns-box h3 {
    margin: 0 0 10px 0; padding-bottom: 5px;
    border-bottom: 1px solid #a89f91;
    font-size: 15px; font-weight: bold; color: #332b22;
    display: flex; justify-content: space-between; align-items: center;
  }
  .sns-box h3 i { margin-right: 5px; opacity: 0.7; }

  /* CAIXAS ESPECÍFICAS DE ENERGIA */
  .energia-box { display: flex; flex-direction: column; align-items: center; padding: 10px; border-radius: 5px; position: relative; }
  .energia-box.vit { background: rgba(250, 230, 230, 0.8); border: 1px solid #c78b8b; }
  .energia-box.vit h3 { border: none; color: #a13d3d; font-size: 16px; margin-bottom: 5px; }
  .energia-box.chk { background: rgba(230, 240, 250, 0.8); border: 1px solid #8baac7; }
  .energia-box.chk h3 { border: none; color: #3d6ba1; font-size: 16px; margin-bottom: 5px; }
  .energia-box.jashin { background: rgba(240, 230, 250, 0.8); border: 1px solid #a98bc7; }
  .energia-box.jashin h3 { border: none; font-family: 'Kaushan Script'; font-size: 20px; margin-bottom: 5px; }
  
  .energia-inputs { display: flex; align-items: center; gap: 10px; font-size: 18px; font-weight: bold; }
  .energia-inputs label { font-size: 10px; color: #665c4d; }
  .energia-inputs input { width: 50px; height: 35px; text-align: center; font-size: 18px; font-weight: bold; background: rgba(0,0,0,0.05); border: 1px solid rgba(0,0,0,0.1); border-radius: 3px; }

  /* TABELAS */
  table.sns-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  table.sns-table th { text-align: left; padding: 5px; color: #665c4d; font-size: 10px; border-bottom: 1px solid #c0b7a6; }
  table.sns-table td { padding: 4px 5px; border-bottom: 1px dashed #dcd3c1; }
  table.sns-table tr:last-child td { border-bottom: none; }
  
  .attr-input { width: 35px; text-align: center; font-size: 14px; font-weight: bold; background: transparent; border: 1px solid #b8b0a1; border-radius: 3px; }
  .attr-input.error { border: 2px solid red; background: #ffe6e6; }
  .attr-readonly { width: 35px; text-align: center; font-size: 14px; background: transparent; border: none; color: #5a4f40; }
  
  .icon-cell { width: 20px; text-align: center; font-size: 14px; opacity: 0.7; }
  .quote-box { margin-top: auto; padding: 15px; font-family: 'Kaushan Script'; font-size: 18px; text-align: center; color: #5a4f40; line-height: 1.3; }

  /* ESTATISTICAS DE COMBATE */
  .estatisticas-table input, .estatisticas-table select {
    background: rgba(0,0,0,0.03); border: 1px solid #b8b0a1; border-radius: 3px; padding: 3px; font-family: 'Marcellus';
  }
  .estatisticas-table .total-box {
    background: #dcd3c1; font-weight: bold; font-size: 16px; border: none; width: 40px; text-align: center;
  }
</style>

<form class="{{cssClass}} shinobi-wrapper" autocomplete="off">
  
  <!-- === TOPO: NOME E SUBTÍTULO === -->
  <div class="top-title-area">
    <div class="logo-placeholder"></div>
    <div>
      <h1>{{actor.name}}</h1>
      <div class="jp-sub">千手 ネトラマ <span style="font-family: 'Marcellus'; font-size: 12px; margin-left: 10px; opacity: 0.7;">(Pressione 'Sheet' para editar o nome)</span></div>
    </div>
  </div>

  <!-- === CABEÇALHO: IMAGEM E DADOS === -->
  <header class="header-grid-area">
    <div class="profile-section">
      <img src="{{actor.img}}" data-edit="img" title="{{actor.name}}"/>
      <div class="vertical-tag">忍者</div>
    </div>
    
    <div class="dados-box">
      <div class="dados-title">
        <span>DADOS DO PERSONAGEM</span>
        <span style="font-weight: normal; margin-right: 70px;">NC</span>
      </div>
      <div style="display: flex; gap: 15px;">
        <div class="dados-grid" style="flex: 1;">
          <div class="campo span-3"><label>NOME</label><input name="name" type="text" value="{{actor.name}}"/></div>
          <div class="campo"><label>GÊNERO</label><input name="system.cabecalho.genero" type="text" value="{{system.cabecalho.genero}}"/></div>
          
          <div class="campo"><label>CLÃ | HIJUTSU</label><input name="system.cabecalho.cla" type="text" value="{{system.cabecalho.cla}}"/></div>
          <div class="campo"><label>PATENTE</label><input name="system.cabecalho.patente" type="text" value="{{system.cabecalho.patente}}"/></div>
          <div class="campo"><label>FILIAÇÃO ATUAL</label><input name="system.cabecalho.filiacao" type="text" value="{{system.cabecalho.filiacao}}"/></div>
          
          <div class="campo"><label>TENDÊNCIA</label><input name="system.cabecalho.tendencia" type="text" value="{{system.cabecalho.tendencia}}"/></div>
          <div class="campo"><label>IDADE</label><input name="system.cabecalho.idade" type="text" value="{{system.cabecalho.idade}}"/></div>
          <div class="campo"><label>LOCAL NASC.</label><input name="system.cabecalho.localNascimento" type="text" value="{{system.cabecalho.localNascimento}}"/></div>
          <div class="campo"><label>SEXUALIDADE</label><input name="system.cabecalho.sexualidade" type="text" value="{{system.cabecalho.sexualidade}}"/></div>
        </div>
        <div class="nc-box">
          <input name="system.cabecalho.nc" type="number" value="{{system.cabecalho.nc}}" data-dtype="Number"/>
        </div>
      </div>
    </div>
  </header>

  <!-- === NAVEGAÇÃO === -->
  <nav class="sns-nav sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="principal"><span class="jp">基本</span> PRINCIPAL</a>
    <a class="item" data-tab="inventario"><span class="jp">道具</span> INVENTÁRIO</a>
    <a class="item" data-tab="poderes"><span class="jp">術</span> PODERES & APTIDÕES</a>
    <a class="item" data-tab="databook"><span class="jp">書物</span> DATABOOK</a>
    <a class="item" data-tab="configuracoes"><span class="jp">設定</span> CONFIGS</a>
  </nav>

  <!-- === CORPO DA FICHA === -->
  <section class="sheet-body">
    
    <!-- ================= ABA PRINCIPAL ================= -->
    <div class="tab principal" data-group="primary" data-tab="principal">
      <div style="display: flex; flex-direction: column; height: 100%;">
        
        <nav class="sheet-tabs tabs" data-group="secundario" style="flex: 0 0 auto; display: flex; gap: 5px; margin-bottom: 10px; border-bottom: 2px solid #5a4f40; padding-bottom: 5px;">
          <a class="item" data-tab="status" style="font-weight: bold; cursor: pointer; padding: 5px 15px; background: rgba(245,240,230,0.7); border: 1px solid #a89f91; border-radius: 5px 5px 0 0; color: #4a3e30;">STATUS & COMBATE</a>
          <a class="item" data-tab="pericias" style="font-weight: bold; cursor: pointer; padding: 5px 15px; background: rgba(245,240,230,0.7); border: 1px solid #a89f91; border-radius: 5px 5px 0 0; color: #4a3e30;">PERÍCIAS & HABILIDADES</a>
        </nav>

        <section class="principal-body" style="flex: 1;">
          
          <!-- SUB-ABA: STATUS -->
          <div class="tab status" data-group="secundario" data-tab="status">
            <div style="display: flex; gap: 15px; flex-wrap: wrap;">
              
              <!-- COLUNA ESQUERDA -->
              <div style="flex: 0 0 320px; display: flex; flex-direction: column;">
                
                <div class="sns-box">
                  <h3>ATRIBUTOS <span style="font-size: 11px; color: {{#if evolucao.atributosNegativo}}red{{else}}#777{{/if}}; font-weight: normal;">(Restam: {{evolucao.atributos}})</span></h3>
                  <table class="sns-table">
                    <thead><tr><th colspan="2">STATUS</th><th style="text-align: center;">VALOR</th><th style="text-align: center;">PRECISÃO</th><th style="text-align: center;">R.M.</th></tr></thead>
                    <tbody>
                      <tr><td class="icon-cell">✊</td><td><a class="rollable" data-nome="Força" data-precisao="{{system.atributos.for.precisao}}" style="cursor:pointer; font-weight:bold;">FORÇA</a></td><td align="center"><input type="number" name="system.atributos.for.valor" value="{{system.atributos.for.valor}}" class="attr-input {{#if erros.atributos.for}}error{{/if}}"/></td><td align="center"><input type="number" value="{{system.atributos.for.precisao}}" class="attr-readonly" readonly/></td><td align="center"><input type="checkbox" name="system.atributos.for.resMaior" {{checked system.atributos.for.resMaior}}/></td></tr>
                      <tr><td class="icon-cell">🗡️</td><td><a class="rollable" data-nome="Destreza" data-precisao="{{system.atributos.des.precisao}}" style="cursor:pointer; font-weight:bold;">DESTREZA</a></td><td align="center"><input type="number" name="system.atributos.des.valor" value="{{system.atributos.des.valor}}" class="attr-input {{#if erros.atributos.des}}error{{/if}}"/></td><td align="center"><input type="number" value="{{system.atributos.des.precisao}}" class="attr-readonly" readonly/></td><td align="center"><input type="checkbox" name="system.atributos.des.resMaior" {{checked system.atributos.des.resMaior}}/></td></tr>
                      <tr><td class="icon-cell">💨</td><td><a class="rollable" data-nome="Agilidade" data-precisao="{{system.atributos.agi.precisao}}" style="cursor:pointer; font-weight:bold;">AGILIDADE</a></td><td align="center"><input type="number" name="system.atributos.agi.valor" value="{{system.atributos.agi.valor}}" class="attr-input {{#if erros.atributos.agi}}error{{/if}}"/></td><td align="center"><input type="number" value="{{system.atributos.agi.precisao}}" class="attr-readonly" readonly/></td><td align="center"><input type="checkbox" name="system.atributos.agi.resMaior" {{checked system.atributos.agi.resMaior}}/></td></tr>
                      <tr><td class="icon-cell">👁️</td><td><a class="rollable" data-nome="Percepção" data-precisao="{{system.atributos.per.precisao}}" style="cursor:pointer; font-weight:bold;">PERCEPÇÃO</a></td><td align="center"><input type="number" name="system.atributos.per.valor" value="{{system.atributos.per.valor}}" class="attr-input {{#if erros.atributos.per}}error{{/if}}"/></td><td align="center"><input type="number" value="{{system.atributos.per.precisao}}" class="attr-readonly" readonly/></td><td align="center"><input type="checkbox" name="system.atributos.per.resMaior" {{checked system.atributos.per.resMaior}}/></td></tr>
                      <tr><td class="icon-cell">🛡️</td><td><a class="rollable" data-nome="Vigor" data-precisao="{{system.atributos.vig.precisao}}" style="cursor:pointer; font-weight:bold;">VIGOR</a></td><td align="center"><input type="number" name="system.atributos.vig.valor" value="{{system.atributos.vig.valor}}" class="attr-input {{#if erros.atributos.vig}}error{{/if}}"/></td><td align="center"><input type="number" value="{{system.atributos.vig.precisao}}" class="attr-readonly" readonly/></td><td align="center"><input type="checkbox" name="system.atributos.vig.resMaior" {{checked system.atributos.vig.resMaior}}/></td></tr>
                      <tr><td class="icon-cell">🧠</td><td><a class="rollable" data-nome="Inteligência" data-precisao="{{system.atributos.int.precisao}}" style="cursor:pointer; font-weight:bold;">INTELIGÊNCIA</a></td><td align="center"><input type="number" name="system.atributos.int.valor" value="{{system.atributos.int.valor}}" class="attr-input {{#if erros.atributos.int}}error{{/if}}"/></td><td align="center"><input type="number" value="{{system.atributos.int.precisao}}" class="attr-readonly" readonly/></td><td align="center"><input type="checkbox" name="system.atributos.int.resMaior" {{checked system.atributos.int.resMaior}}/></td></tr>
                      <tr><td class="icon-cell">👻</td><td><a class="rollable" data-nome="Espírito" data-precisao="{{system.atributos.esp.precisao}}" style="cursor:pointer; font-weight:bold;">ESPÍRITO</a></td><td align="center"><input type="number" name="system.atributos.esp.valor" value="{{system.atributos.esp.valor}}" class="attr-input {{#if erros.atributos.esp}}error{{/if}}"/></td><td align="center"><input type="number" value="{{system.atributos.esp.precisao}}" class="attr-readonly" readonly/></td><td align="center"><input type="checkbox" name="system.atributos.esp.resMaior" {{checked system.atributos.esp.resMaior}}/></td></tr>
                    </tbody>
                  </table>
                </div>

                <div class="sns-box">
                  <h3>ATRIBUTOS SOCIAIS <span style="font-size: 11px; color: {{#if evolucao.sociaisNegativo}}red{{else}}#777{{/if}}; font-weight: normal;">(Restam: {{evolucao.sociais}})</span></h3>
                  <table class="sns-table">
                    <tbody>
                      <tr><td class="icon-cell">🌸</td><td><a class="rollable" data-nome="Carisma (Yang)" data-precisao="{{system.sociais.carisma.precisao}}" style="cursor:pointer; font-weight:bold;">CARISMA (Yang)</a></td><td align="right"><input type="number" name="system.sociais.carisma.valor" value="{{system.sociais.carisma.valor}}" class="attr-input {{#if erros.sociais.carisma}}error{{/if}}"/></td></tr>
                      <tr><td class="icon-cell">🕸️</td><td><a class="rollable" data-nome="Manipulação (Yin)" data-precisao="{{system.sociais.manipulacao.precisao}}" style="cursor:pointer; font-weight:bold;">MANIPULAÇÃO (Yin)</a></td><td align="right"><input type="number" name="system.sociais.manipulacao.valor" value="{{system.sociais.manipulacao.valor}}" class="attr-input {{#if erros.sociais.manipulacao}}error{{/if}}"/></td></tr>
                    </tbody>
                  </table>
                </div>
                
                <div class="sns-box" style="text-align: center; background: rgba(230, 240, 230, 0.6); border-color: #7b9c7b;">
                  <h3 style="justify-content: center; color: #4a6b4a; border-bottom: 1px solid #7b9c7b; margin-bottom: 10px;">📈 PONTOS GERAIS (NC {{evolucao.ncAtual}})</h3>
                  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 5px;">
                    <div style="background: rgba(255,255,255,0.5); padding: 5px; border-radius: 3px; border: 1px solid #b8b0a1;"><strong>Atributos:</strong> <span style="font-size: 14px; font-weight:bold; color: {{#if evolucao.atributosNegativo}}#a13d3d{{else}}#332b22{{/if}};">{{evolucao.atributos}}</span></div>
                    <div style="background: rgba(255,255,255,0.5); padding: 5px; border-radius: 3px; border: 1px solid #b8b0a1;"><strong>Perícias:</strong> <span style="font-size: 14px; font-weight:bold; color: {{#if evolucao.periciasNegativo}}#a13d3d{{else}}#332b22{{/if}};">{{evolucao.pericias}}</span></div>
                    <div style="background: rgba(255,255,255,0.5); padding: 5px; border-radius: 3px; border: 1px solid #b8b0a1;"><strong>Poderes:</strong> <span style="font-size: 14px; font-weight:bold; color: {{#if evolucao.poderesNegativo}}#a13d3d{{else}}#332b22{{/if}};">{{evolucao.poderes}}</span></div>
                    <div style="background: rgba(255,255,255,0.5); padding: 5px; border-radius: 3px; border: 1px solid #b8b0a1;"><strong>Sociais:</strong> <span style="font-size: 14px; font-weight:bold; color: {{#if evolucao.sociaisNegativo}}#a13d3d{{else}}#332b22{{/if}};">{{evolucao.sociais}}</span></div>
                  </div>
                  <div style="font-size: 10px; color: #665c4d; border-top: 1px dashed #b8b0a1; padding-top: 5px; margin-top: 5px;">
                    <strong>Limites:</strong> Atributo [{{evolucao.limiteAtributo}}] | Perícia/Poder [{{evolucao.limitePericiaPoder}}]
                  </div>
                </div>

                <div class="quote-box">
                  "A paz não é algo que se deseja; é algo que se constrói."
                </div>

              </div>

              <!-- COLUNA DIREITA -->
              <div style="flex: 1; display: flex; flex-direction: column; gap: 15px;">
                
                <!-- VITALIDADE E CHAKRA -->
                <div style="display: flex; gap: 15px;">
                  <div class="energia-box vit" style="flex: 1;">
                    <h3>🔥 VITALIDADE</h3>
                    <div class="energia-inputs">
                      <label>ATUAL</label><input type="number" name="system.energias.vitalidade.value" value="{{system.energias.vitalidade.value}}"/>
                      <span>/</span>
                      <label>MÁX</label><input type="number" value="{{system.energias.vitalidade.max}}" readonly style="background:transparent; border:none;"/>
                    </div>
                  </div>
                  <div class="energia-box chk" style="flex: 1;">
                    <h3>🌀 CHAKRA</h3>
                    <div class="energia-inputs">
                      <label>ATUAL</label><input type="number" name="system.energias.chakra.value" value="{{system.energias.chakra.value}}"/>
                      <span>/</span>
                      <label>MÁX</label><input type="number" value="{{system.energias.chakra.max}}" readonly style="background:transparent; border:none;"/>
                    </div>
                    <div style="position: absolute; right: 10px; top: 10px; font-size: 40px; opacity: 0.2; font-family: 'Yusei Magic';">氣</div>
                  </div>
