            <div style="flex: 1; border: 1px solid #b8b0a1; background: rgba(255,255,255,0.3); padding: 5px; overflow-y: auto;">
              {{editor relacoesHTML target="system.databook.relacoesTexto" button=false editable=editable engine="prosemirror"}}
            </div>
          </div>
          <div class="sns-box" style="flex: 1; display: flex; flex-direction: column; min-height: 250px;">
            <h3>💡 CURIOSIDADES & NOTAS</h3>
            <div style="flex: 1; border: 1px solid #b8b0a1; background: rgba(255,255,255,0.3); padding: 5px; overflow-y: auto;">
              {{editor curiosidadesHTML target="system.databook.curiosidades" button=false editable=editable engine="prosemirror"}}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ABA CONFIGS -->
    <div class="tab configuracoes" data-group="primary" data-tab="configuracoes">
      <div class="sns-box">
        <h2>⚙️ CONFIGURAÇÕES DA FICHA</h2>
        <div style="display: flex; flex-direction: column; gap: 15px; margin-top: 15px;">
          <div style="border: 1px solid #b8b0a1; border-radius: 5px; background: rgba(255,255,255,0.3); padding: 10px;">
            <h3 style="border-bottom: 1px solid #b8b0a1; font-size: 14px;">Regras de Progressão (Poderes)</h3>
            <div style="display: flex; gap: 15px;">
              <label><input type="checkbox" name="system.configuracoes.regraTresPontos" {{checked system.configuracoes.regraTresPontos}} data-dtype="Boolean"> 3 Pontos</label>
              <label><input type="checkbox" name="system.configuracoes.regraQuatroPontos" {{checked system.configuracoes.regraQuatroPontos}} data-dtype="Boolean"> 4 Pontos</label>
            </div>
          </div>
          <div style="border: 1px solid #b8b0a1; border-radius: 5px; background: rgba(255,255,255,0.3); padding: 10px;">
            <h3 style="border-bottom: 1px solid #b8b0a1; font-size: 14px;">Aptidões Não Restritas</h3>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 5px;">
              <label><input type="checkbox" name="system.configuracoes.acuidade" {{checked system.configuracoes.acuidade}}> Acuidade (CC usa DES)</label>
              <label><input type="checkbox" name="system.configuracoes.combateDefensivo" {{checked system.configuracoes.combateDefensivo}}> Combate Defensivo (-2 CC, +3 Esq)</label>
              <label><input type="checkbox" name="system.configuracoes.diligente" {{checked system.configuracoes.diligente}}> Diligente (+3 Ini)</label>
              <label><input type="checkbox" name="system.configuracoes.quimico" {{checked system.configuracoes.quimico}}> Químico (Desbloqueia Venefício)</label>
              <label><input type="checkbox" name="system.configuracoes.velocista" {{checked system.configuracoes.velocista}}> Velocista (Deslocamento /1)</label>
              <label><input type="checkbox" name="system.configuracoes.shunjutsu1" {{checked system.configuracoes.shunjutsu1}}> Shunjutsu Nv 1 (Desloc. usa ESP)</label>
              <label><input type="checkbox" name="system.configuracoes.burroCarga" {{checked system.configuracoes.burroCarga}}> Burro de Carga (Aumenta Inventário)</label>
            </div>
          </div>
          <div style="border: 1px solid #b8b0a1; border-radius: 5px; background: rgba(255,255,255,0.3); padding: 10px;">
            <h3 style="border-bottom: 1px solid #b8b0a1; font-size: 14px;">Condições Simples</h3>
            <label><input type="checkbox" name="system.configuracoes.acelerado" {{checked system.configuracoes.acelerado}}> Acelerado (+2 Ini, Deslocamento /1)</label>
          </div>
          <div style="border: 1px solid #b8b0a1; border-radius: 5px; background: rgba(255,255,255,0.3); padding: 10px;">
            <h3 style="border-bottom: 1px solid #b8b0a1; font-size: 14px;">Aptidões e Condições Restritas</h3>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 5px;">
              <label><input type="checkbox" name="system.configuracoes.armaduraOssea" {{checked system.configuracoes.armaduraOssea}}> Armadura Óssea (+ Dureza por VIG)</label>
              <label><input type="checkbox" name="system.configuracoes.byakugou" {{checked system.configuracoes.byakugou}}> Byakugou no In (-15 Chakra)</label>
              <label><input type="checkbox" name="system.configuracoes.chakraExpandido" {{checked system.configuracoes.chakraExpandido}}> Chakra Expandido (+50% Chakra)</label>
              <label><input type="checkbox" name="system.configuracoes.cloneReserva" {{checked system.configuracoes.cloneReserva}}> Clone Reserva (-3 Vit, -5 Chakra)</label>
              <label><input type="checkbox" name="system.configuracoes.controlePerfeito1" {{checked system.configuracoes.controlePerfeito1}}> Cont. Perfeito Nv 1 (Chakra = INT)</label>
              <label><input type="checkbox" name="system.configuracoes.controlePerfeito2" {{checked system.configuracoes.controlePerfeito2}}> Cont. Perfeito Nv 2 (+INT Chakra)</label>
              <label><input type="checkbox" name="system.configuracoes.corpulencia" {{checked system.configuracoes.corpulencia}}> Corpulência (+VIGx3 Vitalidade)</label>
              <label><input type="checkbox" name="system.configuracoes.furtividadePerceptiva" {{checked system.configuracoes.furtividadePerceptiva}}> Furtiv. Perceptiva (Usa PER)</label>
              <label><input type="checkbox" name="system.configuracoes.mantoBijuu" {{checked system.configuracoes.mantoBijuu}}> Manto Bijuu (+1 Dureza)</label>
              <label><input type="checkbox" name="system.configuracoes.modoBijuu" {{checked system.configuracoes.modoBijuu}}> Modo Bijuu (+2 AGI, +2 Dureza)</label>
              <label><input type="checkbox" name="system.configuracoes.formaBijuu" {{checked system.configuracoes.formaBijuu}}> Forma Bijuu (+3 Dureza)</label>
              <label><input type="checkbox" name="system.configuracoes.predadorAquatico" {{checked system.configuracoes.predadorAquatico}}> Predador Aquático (+ Dureza por VIG)</label>
              <label><input type="checkbox" name="system.configuracoes.resiliencia" {{checked system.configuracoes.resiliencia}}> Resiliência (+Dureza, -Desloc, -Esq)</label>
              <label><input type="checkbox" name="system.configuracoes.resistenciaInsaciavel" {{checked system.configuracoes.resistenciaInsaciavel}}> Resis. Insaciável (+ Dureza por VIG)</label>
              <label><input type="checkbox" name="system.configuracoes.rinnegan" {{checked system.configuracoes.rinnegan}}> Rinnegan (-10% Chakra)</label>
              <label><input type="checkbox" name="system.configuracoes.sharinganEsquiva" {{checked system.configuracoes.sharinganEsquiva}}> Sharingan (Esquiva = Ler Mov.)</label>
              <label><input type="checkbox" name="system.configuracoes.shykakyu" {{checked system.configuracoes.shykakyu}}> Shykakyu (+1 Intimidar, +2 Ini)</label>
            </div>
          </div>
          
          <div style="border: 1px solid #b8b0a1; border-radius: 5px; background: rgba(255,255,255,0.3); padding: 10px;">
            <h3 style="border-bottom: 1px solid #b8b0a1; font-size: 14px;">Recurso Extra (Máx. 1)</h3>
            <div style="display: flex; gap: 15px; align-items: center;">
              <select name="system.recursoExtra.ativo" style="padding: 3px; border-radius: 3px; border: 1px solid #b8b0a1; background: transparent;">
                <option value="nenhum" {{#if recIsNenhum}}selected{{/if}}>Nenhum</option>
                <option value="jashin" {{#if recIsJashin}}selected{{/if}}>Boneco de Jashin</option>
                <option value="kikaichuu" {{#if recIsKikaichuu}}selected{{/if}}>Kikaichuu (Aburame)</option>
                <option value="kamiArte" {{#if recIsKamiArte}}selected{{/if}}>Pontos Kami (Arte)</option>
                <option value="kamiEsp" {{#if recIsKamiEsp}}selected{{/if}}>Pontos Kami (Espírito)</option>
                <option value="mangekyou" {{#if recIsMangekyou}}selected{{/if}}>Pontos de Visão Mangekyou</option>
                <option value="kujaku" {{#if recIsKujaku}}selected{{/if}}>Pontos de Saúde Kujaku</option>
                <option value="suika" {{#if recIsSuika}}selected{{/if}}>Pontos Suika (Hozuki)</option>
              </select>
              <label>Cor (HEX):</label>
              <input type="color" name="system.recursoExtra.cor" value="{{system.recursoExtra.cor}}" style="height: 25px; border: none; padding: 0; background: transparent; cursor: pointer;"/>
            </div>
          </div>

        </div>
      </div>
    </div>

  </section>
</form>