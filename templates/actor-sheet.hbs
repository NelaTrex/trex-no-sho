                      <tr><td style="font-weight: bold; text-align: left;">ARMA (DES)</td><td><input type="number" value="{{system.calculadora.danoDestreza.baseAtributo}}" class="attr-readonly" readonly /></td><td><input type="number" name="system.calculadora.danoDestreza.dda" value="{{system.calculadora.danoDestreza.dda}}" class="attr-input"/></td><td><input type="number" name="system.calculadora.danoDestreza.outro" value="{{system.calculadora.danoDestreza.outro}}" class="attr-input"/></td><td><input type="checkbox" name="system.calculadora.danoDestreza.meioGrau" {{checked system.calculadora.danoDestreza.meioGrau}}/></td><td><input type="number" value="{{system.calculadora.danoDestreza.totalBase}}" style="width: 35px; text-align: center; font-weight: bold; background: rgba(0,0,0,0.05); border: none; border-radius: 3px;" readonly /></td><td>{{system.calculadora.danoDestreza.grau1}}</td><td>{{system.calculadora.danoDestreza.grau2}}</td><td>{{system.calculadora.danoDestreza.grau3}}</td><td style="color: green; font-weight: bold;">{{system.calculadora.danoDestreza.grau4}}</td></tr>
